{
  "name": "liberta-bibliainterlinear",
  "version": "0.1.0",
  "private": true,
  "description": "Bíblia interlinear hebraico/aramaico/grego–português (BLIVRE): site, app Android/iOS, EPUB e PDF",
  "scripts": {
    "build": "scripts/build.sh",
    "check-data": "python3 scripts/check_data.py",
    "publish-web": "scripts/publish_web.sh",
    "icons": "node scripts/native_icons.mjs",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "test": "python3 -m pytest tests -q && npx playwright test",
    "test:web": "npx playwright test",
    "test:data": "python3 -m pytest tests -q",
    "check": "tsc -p .",
    "lint": "prettier --check . && eslint . && stylelint \"web/styles/*.css\" && markdownlint-cli2 \"**/*.md\"",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "8.5.2",
    "@capacitor/share": "^8.0.3",
    "@fontsource/gentium-book-plus": "^5.3.0",
    "dexie": "^4.4.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "8.5.2",
    "@eslint/js": "9.39.5",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/literata": "5.3.0",
    "@fontsource/noto-serif-hebrew": "5.3.0",
    "@playwright/test": "^1.64.0",
    "acorn": "8.19.0",
    "acorn-walk": "8.3.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "markdownlint-cli2": "0.23.3",
    "playwright": "^1.64.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "stylelint": "16.26.1",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  }
}
