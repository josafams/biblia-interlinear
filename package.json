{
  "name": "liberta-bibliainterlinear",
  "version": "0.1.0",
  "private": true,
  "license": "CC-BY-SA-4.0",
  "description": "Bíblia interlinear hebraico/aramaico/grego–português (BLIVRE): site, app Android/iOS, EPUB e PDF",
  "scripts": {
    "build": "scripts/build.sh",
    "check-data": "python3 scripts/check_data.py",
    "publish-web": "scripts/publish_web.sh",
    "icons": "node scripts/native_icons.mjs",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "test": "python3 -m pytest tests -q && vitest run && npx playwright test",
    "test:unit": "vitest run",
    "test:web": "npx playwright test",
    "test:data": "python3 -m pytest tests -q",
    "build:web": "vite build",
    "dev": "CHOKIDAR_USEPOLLING=1 vite build --watch --mode development",
    "check": "tsc -p . && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --output human",
    "check:i18n": "node scripts/dev/i18n_check.mjs",
    "check:css": "node scripts/dev/css_compare.mjs",
    "lint": "prettier --check . && eslint . && stylelint \"src/styles/*.css\" && markdownlint-cli2 \"**/*.md\"",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "8.5.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "^8.0.3",
    "@fontsource/gentium-book-plus": "^5.3.0",
    "dexie": "^4.4.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "8.5.2",
    "@eslint/js": "9.39.5",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/literata": "5.3.0",
    "@fontsource/noto-serif-hebrew": "5.3.0",
    "@playwright/test": "^1.64.0",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@types/node": "26.6.4",
    "acorn": "8.19.0",
    "acorn-walk": "8.3.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.1",
    "fake-indexeddb": "6.0.0",
    "globals": "17.13.0",
    "markdownlint-cli2": "0.23.3",
    "playwright": "^1.64.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "3.5.2",
    "sharp": "0.35.5",
    "stylelint": "16.26.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "6.4.5",
    "vitest": "3.2.4"
  }
}
