# Formatação básica igual em qualquer editor (o Prettier e o Ruff fazem o resto)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{java,kt,gradle,swift}]
indent_size = 4

[Makefile]
indent_style = tab

[*.{tsv,md}]
trim_trailing_whitespace = false
